# =============================================================================
# MANTA — Root Monorepo .gitignore
# Stack: Backend (Python 3.12 / FastAPI / ARQ) + Web (Next.js 15 / React 19)
#        + Infra (PostgreSQL 16 / PgBouncer / Valkey 7 / Keycloak / gVisor)
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Environment Variables, Secrets & Cryptographic Material
# -----------------------------------------------------------------------------
.env
.env.*
!.env.example
!.env.template

# Keys, certificates, OIDC/JWKS private keys, KMS/Vault local exports
*.pem
*.key
*.crt
*.p12
*.pfx
*.jks
*.keystore
secrets/
vault/

# -----------------------------------------------------------------------------
# 2. Operating System Artifacts (Windows / macOS / Linux)
# -----------------------------------------------------------------------------
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/
*.lnk
*.stackdump

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Linux
*~
.directory
.Trash-*
.nfs*

# -----------------------------------------------------------------------------
# 3. IDEs & Editors (JetBrains Suite, VS Code, Vim)
# -----------------------------------------------------------------------------
.idea/
*.iml
*.ipr
*.iws
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
*.swp
*.swo
*.swn

# -----------------------------------------------------------------------------
# 4. Docker, Infrastructure & Sandbox Runtime State
# -----------------------------------------------------------------------------
docker-compose.override.yml
compose.override.yml

# Local container bind-mount data volumes (PostgreSQL, Valkey/Redis, Keycloak, Observability)
postgres_data/
pgdata/
valkey_data/
redis_data/
keycloak_data/
prometheus_data/
grafana_data/
jaeger_data/
tempo_data/

# Redis / Valkey persistence dumps
dump.rdb
appendonly.aof*
appendonlydir/

# Database dumps & local SQLite files
*.sql.gz
*.dump
*.db
*.sqlite
*.sqlite3

# Sandbox / MicroVM artifacts & CVE/SBOM scan outputs (gVisor / Firecracker / Trivy / Grype)
*.ext4
*.img
*.qcow2
.trivycache/
trivy-report*.json
grype-report*.json
sbom-report*.json

# Helm local build artifacts
infra/helm/**/charts/*.tgz
infra/helm/*.tgz

# -----------------------------------------------------------------------------
# 5. AI Weights, NLP Caches & Static Code Intelligence (SCIP)
# -----------------------------------------------------------------------------
# Precomputed Sourcegraph SCIP protobuf graphs
*.scip

# Local open-weight models (Qwen2.5-Coder, Llama-3.1, bge-small-en-v1.5, Presidio/spaCy)
*.safetensors
*.gguf
*.onnx
*.pt
*.pth
*.ckpt
*.h5
.huggingface/
hf_cache/
ollama_models/
vllm_cache/

# -----------------------------------------------------------------------------
# 6. Cross-Stack Safety Net (Root-level Python & Node/Next.js invocations)
# Note: Do NOT add unanchored `lib/` here — `web/` uses `lib/` for shadcn/ui.
# -----------------------------------------------------------------------------
# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
.uv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.mutmut-cache
.mutmut-cache/
.coverage
.coverage.*
htmlcov/

# Node / Next.js / Playwright / Vercel
node_modules/
.next/
.turbo/
.vercel/
playwright-report/
test-results/
blob-report/

# -----------------------------------------------------------------------------
# 7. Logs & Temporary Directories
# -----------------------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
tmp/
temp/
