{
  "id": "manta",
  "realm": "manta",
  "displayName": "MANTA Intelligence Platform",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "roles": {
    "realm": [
      {
        "id": "role-developer",
        "name": "DEVELOPER",
        "description": "Software engineer with refactoring and PR access",
        "composite": false,
        "clientRole": false
      },
      {
        "id": "role-scrum-master",
        "name": "SCRUM_MASTER",
        "description": "Scrum Master with sprint velocity, burndown, and reviewer assignment access",
        "composite": false,
        "clientRole": false
      },
      {
        "id": "role-project-manager",
        "name": "PROJECT_MANAGER",
        "description": "Project Manager with sprint planning and scope creep alert oversight",
        "composite": false,
        "clientRole": false
      },
      {
        "id": "role-solution-architect",
        "name": "SOLUTION_ARCHITECT",
        "description": "Solution Architect with ADR sign-off and architecture review gates",
        "composite": false,
        "clientRole": false
      },
      {
        "id": "role-delivery-director",
        "name": "DELIVERY_DIRECTOR",
        "description": "Delivery Director with portfolio delivery health and roadblock intervention",
        "composite": false,
        "clientRole": false
      },
      {
        "id": "role-top-management",
        "name": "TOP_MANAGEMENT",
        "description": "Top Management with strategic read-only portfolio governance",
        "composite": false,
        "clientRole": false
      },
      {
        "id": "role-tenant-admin",
        "name": "TENANT_ADMIN",
        "description": "Tenant administrator with full administrative privileges",
        "composite": false,
        "clientRole": false
      }
    ]
  },
  "clients": [
    {
      "id": "client-manta-portal",
      "clientId": "manta-portal",
      "name": "MANTA Web Portal",
      "description": "Next.js frontend web portal client with PKCE",
      "rootUrl": "http://localhost:3000",
      "baseUrl": "/",
      "surrogateAuthRequired": false,
      "enabled": true,
      "alwaysDisplayInConsole": false,
      "clientAuthenticatorType": "client-secret",
      "redirectUris": [
        "http://localhost:3000/*",
        "http://localhost:8000/*",
        "http://localhost:8080/*"
      ],
      "webOrigins": [
        "*"
      ],
      "notBefore": 0,
      "bearerOnly": false,
      "consentRequired": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "publicClient": true,
      "frontchannelLogout": true,
      "protocol": "openid-connect",
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:3000/*##http://localhost:8080/*"
      },
      "protocolMappers": [
        {
          "id": "mapper-tenant-id",
          "name": "tenant_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "tenant_id",
            "claim.name": "tenant_id",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "multivalued": "false"
          }
        },
        {
          "id": "mapper-audience-backend",
          "name": "audience-manta-backend",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "manta-backend",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ],
      "fullScopeAllowed": true
    },
    {
      "id": "client-manta-backend",
      "clientId": "manta-backend",
      "name": "MANTA Backend API",
      "description": "FastAPI resource server for JWT token verification",
      "enabled": true,
      "bearerOnly": true,
      "protocol": "openid-connect"
    }
  ],
