{
  "id": "manta",
  "realm": "manta",
  "displayName": "MANTA Intelligence Platform",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "accessTokenLifespan": 60,
  "accessTokenLifespanForImplicitFlow": 60,
  "ssoSessionIdleTimeout": 120,
  "ssoSessionMaxLifespan": 600,
  "ssoSessionIdleTimeoutRememberMe": 120,
  "ssoSessionMaxLifespanRememberMe": 600,
  "clientSessionIdleTimeout": 120,
  "clientSessionMaxLifespan": 600,
  "offlineSessionIdleTimeout": 1800,
  "offlineSessionMaxLifespan": 3600,
  "accessCodeLifespan": 60,
  "accessCodeLifespanUserAction": 300,
  "accessCodeLifespanLogin": 1800,
  "roles": {
    "realm": [
      {
        "id": "role-developer",
        "name": "DEVELOPER",
        "description": "Software engineer with refactoring and PR access",
        "composite": false,
        "clientRole": false
      },
      {
        "id": "role-scrum-master",
        "name": "SCRUM_MASTER",
        "description": "Scrum Master with sprint velocity, burndown, and reviewer assignment access",
        "composite": false,
        "clientRole": false
      },
      {
        "id": "role-project-manager",
        "name": "PROJECT_MANAGER",
        "description": "Project Manager with sprint planning and scope creep alert oversight",
        "composite": false,
        "clientRole": false
      },
      {
        "id": "role-solution-architect",
        "name": "SOLUTION_ARCHITECT",
        "description": "Solution Architect with ADR sign-off and architecture review gates",
        "composite": false,
        "clientRole": false
      },
      {
        "id": "role-delivery-director",
        "name": "DELIVERY_DIRECTOR",
        "description": "Delivery Director with portfolio delivery health and roadblock intervention",
        "composite": false,
        "clientRole": false
      },
      {
        "id": "role-top-management",
        "name": "TOP_MANAGEMENT",
        "description": "Top Management with strategic read-only portfolio governance",
        "composite": false,
        "clientRole": false
      },
      {
        "id": "role-tenant-admin",
        "name": "TENANT_ADMIN",
        "description": "Tenant administrator with full administrative privileges",
        "composite": false,
        "clientRole": false
      },
      {
        "id": "role-offline-access",
        "name": "offline_access",
        "description": "${role_offline-access}",
        "composite": false,
        "clientRole": false
      }
    ]
  },
  "clients": [
    {
      "id": "client-manta-portal",
      "clientId": "manta-portal",
      "name": "MANTA Web Portal",
      "description": "Next.js frontend web portal client with PKCE",
      "rootUrl": "http://localhost:3000",
      "baseUrl": "/",
      "surrogateAuthRequired": false,
      "enabled": true,
      "alwaysDisplayInConsole": false,
      "clientAuthenticatorType": "client-secret",
      "redirectUris": [
        "http://localhost:3000/*",
        "http://localhost:8000/*",
        "http://localhost:8080/*"
      ],
      "webOrigins": ["*"],
      "notBefore": 0,
      "bearerOnly": false,
      "consentRequired": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "publicClient": true,
      "frontchannelLogout": true,
      "protocol": "openid-connect",
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:3000/*##http://localhost:8080/*"
      },
      "protocolMappers": [
        {
          "id": "mapper-tenant-id",
          "name": "tenant_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "tenant_id",
            "claim.name": "tenant_id",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "multivalued": "false"
          }
        },
        {
          "id": "mapper-audience-backend",
          "name": "audience-manta-backend",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "manta-backend",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ],
      "fullScopeAllowed": true
    },
    {
      "id": "client-manta-backend",
      "clientId": "manta-backend",
      "name": "MANTA Backend API",
      "description": "FastAPI resource server for JWT token verification",
      "enabled": true,
      "bearerOnly": true,
      "protocol": "openid-connect"
    },
    {
      "id": "client-manta-mobile",
      "clientId": "manta-mobile",
      "name": "MANTA Android Protal",
      "description": "Kotlin Android client with PKCE",
      "rootUrl": "",
      "adminUrl": "",
      "baseUrl": "",
      "surrogateAuthRequired": false,
      "enabled": true,
      "alwaysDisplayInConsole": true,
      "clientAuthenticatorType": "client-secret",
      "redirectUris": ["manta://auth/callback"],
      "webOrigins": [],
      "notBefore": 0,
      "bearerOnly": false,
      "consentRequired": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "publicClient": true,
      "frontchannelLogout": true,
      "protocol": "openid-connect",
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "oidc.ciba.grant.enabled": "false",
        "post.logout.redirect.uris": "manta://auth/callback",
        "oauth2.device.authorization.grant.enabled": "false",
        "backchannel.logout.session.required": "true",
        "backchannel.logout.revoke.offline.tokens": "false"
      },
      "authenticationFlowBindingOverrides": {},
      "fullScopeAllowed": true,
      "nodeReRegistrationTimeout": -1,
      "protocolMappers": [
        {
          "name": "tenant_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "introspection.token.claim": "true",
            "userinfo.token.claim": "true",
            "user.attribute": "tenant_id",
            "id.token.claim": "true",
            "lightweight.claim": "false",
            "access.token.claim": "true",
            "claim.name": "tenant_id",
            "jsonType.label": "String"
          }
        },
        {
          "name": "manta-backend-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "id.token.claim": "false",
            "lightweight.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true",
            "included.custom.audience": "manta-backend"
          }
        }
      ],
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "profile",
        "roles",
        "email"
      ],
      "optionalClientScopes": [
        "address",
        "phone",
        "offline_access",
        "microprofile-jwt"
      ],
      "access": {
        "view": true,
        "configure": true,
        "manage": true
      }
    }
  ],
