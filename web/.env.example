# =============================================================================
# MANTA Web Portal Environment Configuration
#
# Local development defaults are shown below.
# Production containers (matching backend/.env.prod.example) inject HTTPS URLs
# at container runtime via `docker-compose.prod.yml` (served to the browser via
# SSR runtime config & GET /env.js) or via Docker `--build-arg`:
#   APP_ENV=production
#   MANTA_DOMAIN=<your-domain>
#   NEXT_PUBLIC_APP_URL=https://manta.<your-domain>
#   NEXT_PUBLIC_API_URL=https://api.manta.<your-domain>
#   NEXT_PUBLIC_WS_URL=wss://api.manta.<your-domain>/api/v1/ws
#   NEXT_PUBLIC_KEYCLOAK_URL=https://auth.manta.<your-domain>
#   NEXT_PUBLIC_KEYCLOAK_REALM=manta
#   NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=manta-portal
#   NEXT_PUBLIC_REDIRECT_URI=https://manta.<your-domain>/auth/callback
#   NEXT_PUBLIC_POST_LOGOUT_REDIRECT_URI=https://manta.<your-domain>/signed-out
#   NEXT_PUBLIC_ENV_LABEL=PRODUCTION
# =============================================================================

# Portal Public Origin (used for SSR / non-browser OIDC & logout fallbacks)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# API Gateway & Backend (HTTP + derived WebSocket base URL)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/api/v1/ws

# Portal Environment Label (shown in portal header badge)
NEXT_PUBLIC_ENV_LABEL=PRODUCTION

# Keycloak OIDC Provider
NEXT_PUBLIC_KEYCLOAK_URL=http://localhost:8080
NEXT_PUBLIC_KEYCLOAK_REALM=manta
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=manta-portal

# Optional Explicit OIDC Redirect Overrides (derived from NEXT_PUBLIC_APP_URL / window.location.origin if empty)
# NEXT_PUBLIC_REDIRECT_URI=http://localhost:3000/auth/callback
# NEXT_PUBLIC_POST_LOGOUT_REDIRECT_URI=http://localhost:3000/signed-out
