{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "es2022"],
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "rootDir": ".",
    "outDir": ".tmp-unit-tests",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "src/lib/runtime-config.ts",
    "src/lib/auth-tab-sync.ts",
    "src/lib/auth.ts",
    "src/lib/api-client.ts",
    "src/types/tenant-settings.ts",
    "src/lib/tenant-settings-api.ts",
    "src/app/env.js/route.ts",
    "tests/**/*.test.ts"
  ]
}
