# Normalize line endings across Windows dev machines and Linux/gVisor containers
* text=auto eol=lf

# Windows scripts keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Explicitly enforce LF on container, shell, SQL, Python, and web files
*.sh text eol=lf
Dockerfile* text eol=lf
*.dockerfile text eol=lf
*.py text eol=lf
*.sql text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.md text eol=lf

# Binary assets & protobuf graphs
*.scip binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.pdf binary
*.gz binary
*.tgz binary
*.zip binary
