# PostgreSQL Database Settings
POSTGRES_USER=manta_user
POSTGRES_PASSWORD=manta_password
POSTGRES_DB=manta_db
POSTGRES_PORT=5432

# PgBouncer Settings
# All pooling & tenant safety settings are maintained in infra/pgbouncer/pgbouncer.ini
# (pool_mode=transaction, server_reset_query=DISCARD ALL, server_reset_query_always=1)
PGBOUNCER_PORT=6432

# Redis / Valkey Settings
REDIS_PORT=6379

# FastAPI Connection Strings (Routes through PgBouncer inside Docker network)
# Note: Uses postgresql+asyncpg:// for async SQLAlchemy / asyncpg
DATABASE_URL=postgresql+asyncpg://eng_app_user:eng_app_pass_change_in_prod@pgbouncer:5432/manta_db
# Alembic Migration Connection String (Direct to PostgreSQL under admin role)
MIGRATION_DATABASE_URL=postgresql+asyncpg://manta_user:manta_password@postgres:5432/manta_db
REDIS_URL=redis://valkey:6379/0

# App Settings
APP_PORT=8000
# Automatically seed local tenants/users from infra/keycloak/realm-export.json in docker-compose db-init
SEED_DEV_DATA=true

# Keycloak Identity Provider Settings
KEYCLOAK_PORT=8080
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_REALM=manta
KEYCLOAK_INTERNAL_URL=http://keycloak:8080
OIDC_AUDIENCE=manta-backend
OIDC_JWKS_CACHE_TTL_SECONDS=21600
OIDC_JWKS_MIN_REFRESH_INTERVAL_SECONDS=10.0
OIDC_ISSUER=
# Comma-separated extra trusted issuers (e.g. Android emulator 10.0.2.2 / local 127.0.0.1)
OIDC_EXTRA_ISSUERS=http://10.0.2.2:8080/realms/manta,http://127.0.0.1:8080/realms/manta

# Secret & Credential Encryption (SCRUM-321: AES-256-GCM)
ENCRYPTION_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
ACTIVE_ENCRYPTION_KEY_ID=primary

# Recovery Sweeper Settings (SCRUM-388 / SCRUM-389)
SWEEP_INTERVAL_SECONDS=5
SWEEP_THRESHOLD_SECONDS=10
SWEEP_BATCH_SIZE=100
SWEEPER_HEARTBEAT_FILE=/tmp/sweeper.heartbeat

# Outbox Relay Settings (SRS v2.0 §3.5.2)
OUTBOX_RELAY_HEARTBEAT_FILE=/tmp/outbox_relay.heartbeat

# OpenTelemetry Distributed Tracing (TASK-302-2 / US-49)
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317
OTEL_EXPORTER_OTLP_INSECURE=true

# AI / LLM Endpoints
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=llama3.1:8b
LOCAL_EMBEDDING_MODEL=bge-small-en-v1.5
CLOUD_ZDR_LLM_BASE_URL=
CLOUD_ZDR_API_KEY=
CLOUD_ZDR_LLM_MODEL=gpt-4o-mini
CLOUD_ZDR_EMBEDDING_MODEL=text-embedding-3-small
AI_REQUEST_TIMEOUT_SECONDS=30.0
AI_REINDEX_STATUS_TTL_SECONDS=86400

# Firebase Cloud Messaging (Mobile Push Dispatch)
FCM_PROJECT_ID=
FCM_CREDENTIALS_JSON=

# Refactoring Sandbox Execution
SANDBOX_RUNTIME=runsc
SANDBOX_IMAGE_DIGEST=

