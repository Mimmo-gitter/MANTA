# PostgreSQL Database Settings
POSTGRES_USER=manta_user
POSTGRES_PASSWORD=manta_password
POSTGRES_DB=manta_db
POSTGRES_PORT=5432

# PgBouncer Settings
# All pooling & tenant safety settings are maintained in infra/pgbouncer/pgbouncer.ini
# (pool_mode=transaction, server_reset_query=DISCARD ALL, server_reset_query_always=1)
PGBOUNCER_PORT=6432

# Redis / Valkey Settings
REDIS_PORT=6379

# FastAPI Connection Strings (Routes through PgBouncer inside Docker network)
# Note: Uses postgresql+asyncpg:// for async SQLAlchemy / asyncpg
DATABASE_URL=postgresql+asyncpg://manta_user:manta_password@pgbouncer:5432/manta_db
REDIS_URL=redis://valkey:6379/0

# App Settings
APP_PORT=8000

# Keycloak Identity Provider Settings
KEYCLOAK_PORT=8080
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_REALM=manta
KEYCLOAK_INTERNAL_URL=http://keycloak:8080
OIDC_AUDIENCE=manta-backend
OIDC_JWKS_CACHE_TTL_SECONDS=21600

