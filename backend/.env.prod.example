# =============================================================================
# MANTA Production Environment Template (TASK-301-5 / SCRUM-500)
#
# Copy to `backend/.env.prod` on the deployment host (NEVER commit `.env.prod`)
# and populate every <REPLACE_...> placeholder with rotated production secrets
# stored in GitHub Repository Secrets.
# =============================================================================

# Runtime Mode & Migration Safety
APP_ENV=production
SEED_DEV_DATA=false

# Public Domain & Reverse Proxy (Caddy HTTPS)
# Base domain used to render https://manta.<domain>/* in Keycloak production realm
MANTA_DOMAIN=<REPLACE_DOMAIN>
# Optional explicit portal origin override (defaults to https://manta.${MANTA_DOMAIN})
PORTAL_ORIGIN=https://manta.<REPLACE_DOMAIN>
# Public HTTPS URLs
WEB_BASE_URL=https://manta.<REPLACE_DOMAIN>
WEBHOOK_BASE_URL=https://api.manta.<REPLACE_DOMAIN>
# Explicit comma-separated HTTPS origins only (no wildcards, no localhost)
CORS_ORIGINS=https://manta.<REPLACE_DOMAIN>

# Keycloak 24 Production Mode (`start --import-realm` behind Caddy)
KC_HOSTNAME=auth.manta.<REPLACE_DOMAIN>
KC_HTTP_RELATIVE_PATH=/
KC_PROXY_HEADERS=xforwarded
KEYCLOAK_INTERNAL_URL=http://keycloak:8080
KEYCLOAK_REALM=manta
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_ADMIN=admin
# Rotate via: openssl rand -base64 32
KEYCLOAK_ADMIN_PASSWORD=<REPLACE_ROTATED_KEYCLOAK_ADMIN_PASSWORD>
KC_SERVICE_CLIENT_ID=manta-backend
KC_SERVICE_CLIENT_SECRET=

# Backend OIDC / JWKS Validation
OIDC_AUDIENCE=manta-backend
OIDC_ISSUER=https://auth.manta.<REPLACE_DOMAIN>/realms/manta
# Use internal Docker URL for low-latency JWKS fetch (or public https://auth.manta.<domain>/...)
OIDC_JWKS_URL=http://keycloak:8080/realms/manta/protocol/openid-connect/certs
OIDC_EXTRA_ISSUERS=

# PostgreSQL 16 & PgBouncer (SCRAM-SHA-256)
# Note: infra/pgbouncer/pgbouncer.ini sets `auth_user = manta_user`.
POSTGRES_USER=manta_user
# Rotate via: openssl rand -base64 32 (URL-encode special chars in connection strings below)
POSTGRES_PASSWORD=<REPLACE_ROTATED_POSTGRES_PASSWORD>
POSTGRES_DB=manta_db
# Rotate via: openssl rand -base64 32 (synced to eng_app_user by run_prod_migrations.py)
ENG_APP_DB_PASSWORD=<REPLACE_ROTATED_ENG_APP_DB_PASSWORD>
# Application traffic routes through PgBouncer as least-privilege eng_app_user (NOBYPASSRLS)
DATABASE_URL=postgresql+asyncpg://eng_app_user:<REPLACE_URLENCODED_ENG_APP_DB_PASSWORD>@pgbouncer:5432/manta_db
# Alembic migrations connect directly to PostgreSQL as admin role
MIGRATION_DATABASE_URL=postgresql+asyncpg://manta_user:<REPLACE_URLENCODED_POSTGRES_PASSWORD>@postgres:5432/manta_db

# Valkey / Redis 7
REDIS_URL=redis://valkey:6379/0

# AES-256-GCM Secret Vault Encryption Key (SCRUM-321)
# Rotate via: openssl rand -hex 32 (MUST be 64 hex characters, never the dev default)
ENCRYPTION_MASTER_KEY=<REPLACE_64_HEX_ENCRYPTION_MASTER_KEY>
ENCRYPTION_KEYRING_JSON=
ACTIVE_ENCRYPTION_KEY_ID=primary

# Production SMTP (Member Invitations)
SMTP_HOST=<REPLACE_SMTP_HOST>
SMTP_PORT=587
SMTP_USER=<REPLACE_SMTP_USER>
SMTP_PASSWORD=<REPLACE_SMTP_PASSWORD>
SMTP_FROM=noreply@manta.<REPLACE_DOMAIN>
SMTP_START_TLS=true

# Background Workers & Observability
SWEEP_INTERVAL_SECONDS=5
SWEEP_THRESHOLD_SECONDS=10
SWEEP_BATCH_SIZE=100
WORKER_METRICS_PORT=9101
LOG_LEVEL=INFO
